#!/usr/bin/env bash
# ==============================================================================
# 📐 SDD (Spec-Driven Development) CLI for Data Structures & Algorithms
# ==============================================================================
set -e

# Resolve repository root
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# Terminal Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

function show_help() {
    echo -e "${BOLD}${CYAN}📐 Spec-Driven Development (SDD) CLI${NC}"
    echo -e "Enforce formal specifications, invariant proofs, and test-first engineering.\n"
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  ./sdd <command> [arguments]\n"
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "  ${GREEN}new${NC} <Category> <ProblemName>   Scaffold a new .spec.md and Java starter boilerplate"
    echo -e "  ${GREEN}test${NC} [ProblemName | all]       Compile and execute test suite (default: all)"
    echo -e "  ${GREEN}verify${NC} [ProblemName]            Validate spec completeness, build, and test invariants"
    echo -e "  ${GREEN}status${NC}                          Display SDD repository coverage & lifecycle matrix"
    echo -e "  ${GREEN}help${NC}                            Show this guidance message\n"
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo -e "  ./sdd new Arrays SlidingWindowMaximum"
    echo -e "  ./sdd test TrappingRainWater"
    echo -e "  ./sdd verify"
    echo -e "  ./sdd status\n"
}

function cmd_new() {
    local category="$1"
    local problem="$2"

    if [[ -z "$category" || -z "$problem" ]]; then
        echo -e "${RED}Error: Both Category and ProblemName are required.${NC}"
        echo -e "Usage: ./sdd new <Category> <ProblemName>"
        echo -e "Example: ./sdd new Arrays SlidingWindowMaximum"
        exit 1
    fi

    local spec_dir="specs/$category"
    local src_dir="src/$category"
    local spec_file="$spec_dir/$problem.spec.md"
    local java_file="$src_dir/$problem.java"

    mkdir -p "$spec_dir" "$src_dir"

    # 1. Create Spec from Template
    if [[ -f "$spec_file" ]]; then
        echo -e "${YELLOW}Warning: Spec file already exists at $spec_file${NC}"
    else
        if [[ -f "specs/TEMPLATE.spec.md" ]]; then
            sed -e "s/\[Problem Title\]/$problem/g" \
                -e "s/\[ProblemName\]/$problem/g" \
                -e "s/\[Category\]/$category/g" \
                "specs/TEMPLATE.spec.md" > "$spec_file"
        else
            cat <<EOF > "$spec_file"
# SPEC: $problem

> **Status**: \`DRAFT\`  
> **Category**: \`$category\`  
> **Target Complexity**: Time \`O(N)\` | Space \`O(1)\`  

## 1. Problem Formulation & API Contract
## 2. Mathematical Invariants & Algorithmic Principles
## 3. Constraints & Complexity Budget
## 4. Acceptance Criteria & Test Matrix
## 5. Design & Algorithmic Strategy
## 6. Verification Trace Table
EOF
        fi
        echo -e "${GREEN}✓ Created specification:${NC} $spec_file"
    fi

    # 2. Create Java Starter if absent
    if [[ -f "$java_file" ]]; then
        echo -e "${YELLOW}Notice: Java source already exists at $java_file${NC}"
    else
        cat <<EOF > "$java_file"
package $category;

/**
 * ============================================================================
 * Problem: $problem
 * Spec: specs/$category/$problem.spec.md
 * Status: DRAFT -> IMPLEMENTED
 * ============================================================================
 */
public class $problem {

    public static void main(String[] args) {
        System.out.println("=== Testing: $problem ===");

        // TODO: Port Acceptance Criteria from specs/$category/$problem.spec.md
        // Example:
        // assert solve(...) == expected : "TC-01 failed";

        System.out.println("All $problem test cases PASSED!");
    }

    public static int solve() {
        // TODO: Implement solution satisfying the spec invariants
        return 0;
    }
}
EOF
        echo -e "${GREEN}✓ Created Java starter:${NC} $java_file"
    fi

    echo -e "\n${BOLD}${CYAN}🚀 Next Steps for Spec-Driven Development:${NC}"
    echo -e "  1. Edit ${BOLD}$spec_file${NC} (Define Invariants, Constraints, Test Matrix)"
    echo -e "  2. Review & approve approach (Set Status: \`APPROVED\`)"
    echo -e "  3. Implement solution in ${BOLD}$java_file${NC}"
    echo -e "  4. Verify with: ${BOLD}./sdd verify $problem${NC}\n"
}

function cmd_test() {
    local target="${1:-all}"
    mkdir -p out

    if [[ "$target" == "all" ]]; then
        echo -e "${CYAN}Compiling and running comprehensive test suite...${NC}"
        javac -d out $(find src test -name "*.java" ! -name "SampleTest.java")
        javac -d out $(find OOP/src DesignPatterns/src -name "*.java" 2>/dev/null || true)
        java -ea -cp out test.AllTestsRunner
    else
        # Search for the target problem class
        local java_file=$(find src -name "$target.java" | head -n 1)
        if [[ -z "$java_file" ]]; then
            echo -e "${RED}Error: Could not find $target.java under src/${NC}"
            exit 1
        fi

        local rel_path="${java_file#src/}"
        local class_name="${rel_path%.java}"
        local fqcn="${class_name//\//.}"

        echo -e "${CYAN}Compiling and testing $fqcn...${NC}"
        javac -d out $(find src/Utils -name "*.java") "$java_file"
        java -ea -cp out "$fqcn"
        echo -e "${GREEN}✓ $target passed standalone verification!${NC}"
    fi
}

function cmd_verify() {
    local target="$1"
    mkdir -p out

    if [[ -n "$target" ]]; then
        echo -e "${BOLD}${CYAN}🔍 Verifying Spec-Driven Compliance for:${NC} $target"
        local spec_file=$(find specs -name "$target.spec.md" | head -n 1)
        local java_file=$(find src -name "$target.java" | head -n 1)

        if [[ -z "$spec_file" ]]; then
            echo -e "${RED}✗ Missing Specification:${NC} No spec found matching $target in specs/"
            exit 1
        fi
        echo -e "${GREEN}✓ Found spec:${NC} $spec_file"

        # Check required sections
        local missing=0
        for section in "Problem Formulation" "Invariants" "Constraints" "Acceptance Criteria" "Design & Algorithmic Strategy"; do
            if ! grep -qi "$section" "$spec_file"; then
                echo -e "${YELLOW}  ⚠ Warning: Missing section '$section' in $spec_file${NC}"
                missing=$((missing + 1))
            fi
        done

        if [[ $missing -eq 0 ]]; then
            echo -e "${GREEN}✓ Spec structure: Complete (All 5 core architectural sections present)${NC}"
        fi

        if [[ -z "$java_file" ]]; then
            echo -e "${RED}✗ Missing Implementation:${NC} No Java source found for $target in src/"
            exit 1
        fi
        echo -e "${GREEN}✓ Found source:${NC} $java_file"

        # Test execution
        cmd_test "$target"
        echo -e "\n${BOLD}${GREEN}✓ $target is fully COMPLIANT with Spec-Driven Development!${NC}"
    else
        echo -e "${BOLD}${CYAN}======================================================${NC}"
        echo -e "${BOLD}${CYAN}   RUNNING REPOSITORY-WIDE SDD COMPLIANCE VERIFICATION${NC}"
        echo -e "${BOLD}${CYAN}======================================================${NC}\n"

        local total_specs=0
        local verified_specs=0
        local draft_specs=0

        while IFS= read -r spec; do
            [[ -z "$spec" ]] && continue
            total_specs=$((total_specs + 1))
            local base=$(basename "$spec" .spec.md)

            if grep -qi "Status.*VERIFIED" "$spec"; then
                verified_specs=$((verified_specs + 1))
                echo -e "  [${GREEN}VERIFIED${NC}]    $base (${spec#specs/})"
            elif grep -qi "Status.*IMPLEMENTED" "$spec"; then
                echo -e "  [${BLUE}IMPLEMENTED${NC}] $base (${spec#specs/})"
            elif grep -qi "Status.*APPROVED" "$spec"; then
                echo -e "  [${CYAN}APPROVED${NC}]   $base (${spec#specs/})"
            else
                draft_specs=$((draft_specs + 1))
                echo -e "  [${YELLOW}DRAFT${NC}]      $base (${spec#specs/})"
            fi
        done < <(find specs -name "*.spec.md" ! -name "TEMPLATE.spec.md" | sort)

        echo -e "\n${CYAN}Compiling and running complete test suite...${NC}"
        javac -d out $(find src test -name "*.java" ! -name "SampleTest.java")
        javac -d out $(find OOP/src DesignPatterns/src -name "*.java" 2>/dev/null || true)
        java -ea -cp out test.AllTestsRunner

        echo -e "\n${BOLD}${GREEN}======================================================${NC}"
        echo -e "${BOLD}${GREEN}✓ SDD VERIFICATION PASSED: Tests Green & Specs Validated${NC}"
        echo -e "${BOLD}${GREEN}======================================================${NC}"
    fi
}

function cmd_status() {
    echo -e "${BOLD}${CYAN}======================================================${NC}"
    echo -e "${BOLD}${CYAN}       SPEC-DRIVEN DEVELOPMENT (SDD) STATUS           ${NC}"
    echo -e "${BOLD}${CYAN}======================================================${NC}\n"

    local total_src=$(find src -name "*.java" ! -path "*/Utils/*" | wc -l | tr -d ' ')
    local total_specs=$(find specs -name "*.spec.md" ! -name "TEMPLATE.spec.md" | wc -l | tr -d ' ')

    local verified=$(grep -ri --exclude="TEMPLATE.spec.md" "Status.*VERIFIED" specs/ 2>/dev/null | wc -l | tr -d ' ')
    local implemented=$(grep -ri --exclude="TEMPLATE.spec.md" "Status.*IMPLEMENTED" specs/ 2>/dev/null | wc -l | tr -d ' ')
    local draft=$(grep -ri --exclude="TEMPLATE.spec.md" "Status.*DRAFT" specs/ 2>/dev/null | wc -l | tr -d ' ')

    echo -e "  Total Algorithmic Solutions in src/:  ${BOLD}$total_src${NC}"
    echo -e "  Total Specifications in specs/:       ${BOLD}$total_specs${NC}"
    echo -e "  Status Breakdown:                     ${GREEN}$verified Verified${NC} | ${BLUE}$implemented Implemented${NC} | ${YELLOW}$draft Draft${NC}\n"

    echo -e "${BOLD}Current Specifications:${NC}"
    find specs -name "*.spec.md" ! -name "TEMPLATE.spec.md" | sort | while read -r s; do
        local name=$(basename "$s" .spec.md)
        local status=$(grep -m 1 "Status" "$s" | sed 's/.*`\([^`]*\)`.*/\1/' || echo "UNKNOWN")
        printf "  %-30s %-20s %s\n" "$name" "[$status]" "$s"
    done

    echo -e "\n${BOLD}Unspecified Solutions (Candidates for SDD Backporting):${NC}"
    local count=0
    find src -name "*.java" ! -path "*/Utils/*" | sort | while read -r j; do
        local base=$(basename "$j" .java)
        if ! find specs -name "$base.spec.md" | grep -q .; then
            if [[ $count -lt 8 ]]; then
                echo -e "  - ${YELLOW}$base${NC} (${j#src/})"
            fi
            count=$((count + 1))
        fi
    done
    local unspec_count=$(find src -name "*.java" ! -path "*/Utils/*" | while read -r j; do
        base=$(basename "$j" .java)
        find specs -name "$base.spec.md" | grep -q . || echo 1
    done | wc -l | tr -d ' ')

    if [[ $unspec_count -gt 8 ]]; then
        echo -e "  ... and $((unspec_count - 8)) more (run ${BOLD}./sdd new <Category> <Name>${NC} to create specs)"
    fi
    echo ""
}

# Main Dispatcher
case "$1" in
    new)
        cmd_new "$2" "$3"
        ;;
    test)
        cmd_test "$2"
        ;;
    verify)
        cmd_verify "$2"
        ;;
    status)
        cmd_status
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}\n"
        show_help
        exit 1
        ;;
esac
